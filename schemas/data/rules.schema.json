{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openphonograms.org/schemas/rules.schema.json",
  "title": "Spelling rule catalog",
  "description": "Single source of truth for the 31 spelling rules (Logic of English).",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": {
        "type": "object",
        "required": ["number", "stage", "name", "words"],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Rule number as string (preserves formatting, prevents int parsing)."
          },
          "stage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Stage in which the rule is taught."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable rule name."
          },
          "words": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
